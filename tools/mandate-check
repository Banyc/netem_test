#!/usr/bin/env python3
"""`mandate-check` — run the mandate battery, then archive and compare the run.

The battery is `mandate_check.main`; everything after it is the history step:

1. **archive** the run's artifacts under a durable root (`$PERF_ARCHIVE_DIR`,
   default `~/.net-perf-history`) so the numbers survive the temp tree they were
   written in. A run directory under a temp root is swept; an incident earlier in
   this workspace proved the cost of that;
2. **compare** it to the previous archived run and write `vs-prev.md` with the
   degradation figure per arm and metric, using the Rust tool
   (`netem-test/src/bin/perf-history.rs`), which also re-invokes the existing A/B
   tool for the coverage and claim axes;
3. **fail the invocation on an M1 degradation.** M1 is the interactive tail and
   the standing priority: a run whose interactive tail is worse than the previous
   run's is a rejection, and the wrapper's exit status carries that so no caller
   can read the run as a pass.

The history step never changes the battery's own verdict — a battery that failed
still fails, and this only *adds* a rejection. `--no-history` skips it.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

TOOLS_DIR = Path(__file__).resolve().parent
# cargo builds this bin into the *workspace* target when run from the workspace
# root, and into the crate's own target when run from the crate directory. Look
# for both rather than guessing, because guessing wrong silently skipped the
# history step — a run went unarchived with only a warning to say so.
BINARY_CANDIDATES = (
    TOOLS_DIR.parent / "target" / "release" / "perf-history",
    TOOLS_DIR.parent / "netem-test" / "target" / "release" / "perf-history",
)


def find_binary() -> Path | None:
    for candidate in BINARY_CANDIDATES:
        if candidate.is_file():
            return candidate
    return None


def run_dir_from(argv) -> Path | None:
    """The `--dir` the battery was given, else the runner's own default."""
    for index, arg in enumerate(argv):
        if arg == "--dir" and index + 1 < len(argv):
            return Path(argv[index + 1]).expanduser()
        if arg.startswith("--dir="):
            return Path(arg.split("=", 1)[1]).expanduser()
    try:
        sys.path.insert(0, str(TOOLS_DIR))
        from mandate_check import default_out_dir  # type: ignore

        return default_out_dir()
    except Exception:  # the runner is the authority; if it will not answer, skip
        return None


def history(run_dir: Path, argv) -> int:
    """Archive + compare + report. Returns the exit status this step implies."""
    binary = find_binary()
    if binary is None:
        print(
            "mandate-check: warning: perf-history is not built, so this run was not "
            "archived and not compared to the previous one "
            "(build it: cargo build --release -p netem-test --bin perf-history)",
            file=sys.stderr,
        )
        return 0
    label_flag = []
    for index, arg in enumerate(argv):
        if arg == "--history-label" and index + 1 < len(argv):
            label_flag = ["--label", argv[index + 1]]
    command = [str(binary), str(run_dir), *label_flag]
    try:
        completed = subprocess.run(command, check=False)
    except OSError as error:
        print(f"mandate-check: warning: could not run perf-history: {error}", file=sys.stderr)
        return 0
    return completed.returncode


def main() -> int:
    argv = sys.argv[1:]
    sys.path.insert(0, str(TOOLS_DIR))
    from mandate_check import main as battery_main  # type: ignore

    battery_status = battery_main(argv)
    if "--no-history" in argv:
        return battery_status

    run_dir = run_dir_from(argv)
    if run_dir is None:
        print(
            "mandate-check: warning: no run directory found, so this run was not "
            "archived or compared",
            file=sys.stderr,
        )
        return battery_status

    history_status = history(run_dir, argv)
    # The battery's own failure is reported first: the history step adds a
    # rejection, it never explains one away.
    if battery_status != 0:
        return battery_status
    return history_status


if __name__ == "__main__":
    raise SystemExit(main())
